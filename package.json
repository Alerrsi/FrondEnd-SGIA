{
  "name": "sgia-frontend",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @sgia/web dev",
    "dev:mobile": "pnpm --filter @sgia/mobile start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "turbo": "^2.3.3",
    "typescript": "~6.0.3"
  }
}